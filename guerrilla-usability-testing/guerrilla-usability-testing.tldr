		{
			"x": 8785.39297853084,
			"y": 2213.713841314911,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"type": "text",
			"props": {
				"color": "black",
				"size": "xl",
				"w": 1497.5469897799012,
				"font": "draw",
				"autoSize": false,
				"scale": 1,
				"textAlign": "start",
				"richText": {
					"type": "doc",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Handlinger:"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "* Tegne en bedre forside (Main CTA + 3 bokser + grunn til Lexploria)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "* Registrer deg-problematikk (tydligere + beholde data/Annotations) - og dele annotations. (grupper mm)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "* Grupper kan være en måte å få flere brukere på. Alle med epostadresse. Sende melding via app'en."
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "* Prosjekter med flere annotations. Dele et prosjekt med en gruppe."
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "* Layout på app (meny, søk, Lexploria)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "* Ikoner"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "* Citations (inngående og utgående). Få citations-lister ut av dokumentet"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "*"
								}
							]
						}
					]
				}
			},
