		},
		{
			"x": 3260.2855162876203,
			"y": 5850.332926625788,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:q49UwxKjLC20mmUc6aziR",
			"type": "text",
			"props": {
				"color": "black",
				"size": "xl",
				"w": 6944.203125,
				"font": "mono",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "🧵 Kollektiv-tråd om litt ideer:"
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									}
								},
								{
									"type": "text",
									"text": "Folk er med rette ikke spesielt glade i regelen f.eks. Ruter# og Vy har for billettkontroll. Selv om du har gyldig billett må du kunne vise den fram når du blir kontrollert. Ellers får du kontrollgebyr. En regel i stor grad for å slippe å kontrollere i etterkant."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Kanskje også unngå noe spekulasjon i å lure systemet."
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									}
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									}
								},
								{
									"type": "text",
									"text": "Det du mister med en sånn regel er gjensidig respekt og tiltro. Kollektivselskapene er avhengig av penger og jeg har betalt min andel. Likevel får jeg kontrollgebyr. Det er et brudd på samfunnskontrakten, selv om den juridiske avtalen er ok."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Og så har du noen nesten-regler om at du slipper et gebyr i året hvis du ellers betaler. Men hva om den regelen var uttalt og ut fra noen andre variabler så får du strøket et gebyr hver 12 måned hvis du kan vise til at du har betalt ofte nok?"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Du kan også se at "
								}
							]
						}
					]
				}
			},
			"parentId": "page:JxdvFyJEOD-mJuztFtK4Y",
			"index": "b0ZSiX",
			"typeName": "shape"
		},
